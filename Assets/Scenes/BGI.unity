  m_Name: 
  m_EditorClassIdentifier: '::'
  dialogueManager: {fileID: 1816517632}
  player: {fileID: 704047117}
  imageCycler: {fileID: 1513444879}
  gameObjectManager: {fileID: 939889224}
  initialLines:
  - You must be the new guy around here. I'm Vinny.
  - There haven't been any new ones around in a while, it's good to see a fresh face.
  - Oh... You're here for Thale's hands? Let's make a bet real quick, how about that?
  - 'If you can prove to me that you can make something good, I''ll let you have
    them. If not, I get your hands too. Deal? '
  naggingLines:
  - Nah, that's no good.
  - My rightmost cube could draw that better.
  - Have you held a pen before?
  dyingLines:
  - 'You actually like that?... That? No one has ever defied me before. '
  - 'NO! What is this? NOOOOOOOOO! '
  characterName: Vinny
  whiteFlash: {fileID: 1422293973}
  house: {fileID: 1898331727}
  badGuyObject: {fileID: 1710890277}
  hands: {fileID: 1770782938}
  currentPhase: 0
  interactPrompt: {fileID: 1490005383}
