  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6cf925c1123ef4d73a46be661f8e7fef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueManager: {fileID: 189047556}
  interactPrompt: {fileID: 993905922}
  awakeTeleport: {fileID: 1320445776}
  asleepTeleport: {fileID: 1417732903}
  playerTeleport: {fileID: 1189359872}
  player: {fileID: 362494561}
  animator: {fileID: 1545073556}
  OarParent: {fileID: 1421531123}
  dialogueLines:
  - '*Yawn* DO YOU THINK YOU CAN BARGE INTO PEOPLE''S HOUSES? THIS ISN''T ANIMAL
    CROSSING??'
  - Oh... I left the door open. Oops well how did you get here?
  - You don't know? That's alright. We all are here for some reason, even if we don't
    know the reason.
  - 'I say "we all" but it''s only me that is left. Everyone else broke down due
    to the new guy in town. '
  - He makes deals for a living, a swindler. Lost my own hands to him. I would try
    to get them back but I can't get over to his island.
  - I have oars somewhere around the island, and you could use my boat to go over
    there! Could you get my hands back?
  - I can't do anything else around the island but sleep, so I'll be here until you
    get back his place
  characterName: Thale
